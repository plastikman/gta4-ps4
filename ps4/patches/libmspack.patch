diff --git a/libmspack/mspack/lzx.h b/libmspack/mspack/lzx.h
index 281fe5f..d210a88 100644
--- a/libmspack/mspack/lzx.h
+++ b/libmspack/mspack/lzx.h
@@ -73,6 +73,9 @@ struct lzxd_stream {
